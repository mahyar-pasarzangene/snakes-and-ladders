{
  "name": "snakes-and-ladders-party",
  "version": "1.0.0",
  "description": "Multiplayer Snakes & Ladders TV party game — TV display + phone controllers, bilingual EN/FA, LAN or internet",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
