# ── Server configuration (all optional — sensible LAN defaults) ─────────
# Port to listen on (public hosts inject this automatically).
PORT=3000

# Base URL encoded in the TV QR code, no trailing slash.
#   Mode A (LAN):    leave unset — the server auto-detects its LAN IP
#                    (and prefers the address the TV itself connected from).
#   Mode B/C (web):  set to your public frontend URL, e.g.
# PUBLIC_BASE_URL=https://snakes.example.com

# WebSocket URL handed to browser clients. Unset = same origin (Modes A/C).
# Mode B example:
# WS_URL=wss://snakes-and-ladders-ws.onrender.com

# Comma-separated origins allowed to connect (Mode B). Unset = any (LAN).
# ALLOWED_ORIGINS=https://snakes.example.com

# Set to false when the frontend is hosted elsewhere (Mode B backend-only).
SERVE_STATIC=true
